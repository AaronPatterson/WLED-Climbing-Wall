<?xml version="1.0" encoding="utf-8"?>
<!-- A crossed-out circle rather than a bin. Clearing the wall turns lights off;
     it does not delete anything. Once saved routes exist, a bin here would be
     read as "delete this route" by exactly the person least able to undo it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <path android:pathData="M3.5,12 a8.5,8.5 0 1,0 17,0 a8.5,8.5 0 1,0 -17,0 Z"
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FF000000" android:strokeWidth="2" />
    <path android:pathData="M8.8,8.8 L15.2,15.2" android:strokeColor="#FF000000" android:strokeWidth="2" android:strokeLineCap="round" />
    <path android:pathData="M15.2,8.8 L8.8,15.2" android:strokeColor="#FF000000" android:strokeWidth="2" android:strokeLineCap="round" />
</vector>
