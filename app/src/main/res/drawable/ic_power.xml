<?xml version="1.0" encoding="utf-8"?>
<!--
    The IEC power symbol, drawn here rather than pulled from
    material-icons-extended: that library is large and minify is off, so it
    would add several megabytes to ship two glyphs.

    Stroked rather than filled, so the weight is one number. Icon() applies its
    tint over the whole drawable, which is what lets the same file read green
    when the wall is on and muted when it is off.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M12,3 L12,11"
        android:strokeColor="#FF000000"
        android:strokeWidth="2.2"
        android:strokeLineCap="round" />
    <path
        android:pathData="M7.6,6.4 A7,7 0 1 0 16.4,6.4"
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FF000000"
        android:strokeWidth="2.2"
        android:strokeLineCap="round" />
</vector>
